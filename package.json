{
    "name": "ng-circle-countdown",
    "version": "20.0.2",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "build_lib": "ng build ng-circle-countdown",
        "copy-license": "copy ./LICENSE ./dist/ng-circle-countdown",
        "copy-readme": "copy ./README.md ./dist/ng-circle-countdown",
        "copy-files": "npm run copy-license && npm run copy-readme",
        "create-link": "cd dist/ng-circle-countdown && npm link",
        "npm_pack": "npm run copy-files && cd dist/ng-circle-countdown && npm pack",
        "package": "npm run build_lib && npm run npm_pack",
        "watch": "ng build --watch --configuration development",
        "test": "jest --coverage",
        "test-ci": "jest --runInBand"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^20.1.2",
        "@angular/common": "^20.1.2",
        "@angular/compiler": "^20.1.2",
        "@angular/core": "^20.1.2",
        "@angular/forms": "^20.1.2",
        "@angular/platform-browser": "^20.1.2",
        "@angular/platform-browser-dynamic": "^20.1.2",
        "@angular/router": "^20.1.2",
        "rxjs": "~7.8.0",
        "tslib": "^2.8.1",
        "worker-timers": "^8.0.23",
        "zone.js": "~0.15.0"
    },
    "devDependencies": {
        "@angular/build": "^20.1.1",
        "@angular/cli": "~20.1.1",
        "@angular/compiler-cli": "^20.1.2",
        "@types/jest": "^29.5.8",
        "eslint": "^8.51.0",
        "jest": "^29.7.0",
        "jest-preset-angular": "^14.6.1",
        "ng-packagr": "^20.1.0",
        "prettier": "^3.0.1",
        "typescript": "~5.8.3"
    }
}
