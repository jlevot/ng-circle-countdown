{
    "name": "ng-circle-countdown",
    "version": "20.0.2",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "build_lib": "ng build ng-circle-countdown",
        "copy-license": "copy ./LICENSE ./dist/ng-circle-countdown",
        "copy-readme": "copy ./README.md ./dist/ng-circle-countdown",
        "copy-files": "npm run copy-license && npm run copy-readme",
        "create-link": "cd dist/ng-circle-countdown && npm link",
        "npm_pack": "npm run copy-files && cd dist/ng-circle-countdown && npm pack",
        "package": "npm run build_lib && npm run npm_pack",
        "watch": "ng build --watch --configuration development",
        "test": "jest --coverage",
        "test-ci": "jest --runInBand"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^21.2.12",
        "@angular/common": "^21.2.12",
        "@angular/compiler": "^21.2.12",
        "@angular/core": "^21.2.12",
        "@angular/forms": "^21.2.12",
        "@angular/platform-browser": "^21.2.12",
        "@angular/platform-browser-dynamic": "^21.2.12",
        "@angular/router": "^21.2.12",
        "rxjs": "~7.8.0",
        "tslib": "^2.8.1",
        "worker-timers": "^8.0.23",
        "zone.js": "~0.15.0"
    },
    "devDependencies": {
        "@angular/build": "^21.2.10",
        "@angular/cli": "~21.2.10",
        "@angular/compiler-cli": "^21.2.12",
        "@types/jest": "^30.0.0",
        "eslint": "^10.3.0",
        "jest": "^30.3.0",
        "jest-preset-angular": "^16.1.4",
        "ng-packagr": "^21.2.3",
        "prettier": "^3.0.1",
        "typescript": "~5.9.3"
    }
}
